# ============================================================
# РАЗДЕЛ 1: ОСНОВНЫЕ НАСТРОЙКИ ЗАПУСКА И СРЕДЫ
# ============================================================

# Команда запуска приложения (используется по умолчанию)
run = ["python", "manage.py", "runserver", "0.0.0.0:3000"]

# Точка входа – скрипт manage.py (обычно Django)
entrypoint = "manage.py"

# Модули (интерпретатор/версия языка)
modules = ["python-3.11"]

# Скрытые папки (не публикуются, не синхронизируются)
hidden = [".pythonlibs"]

# ============================================================
# РАЗДЕЛ 2: NIX – УПРАВЛЕНИЕ СИСТЕМНЫМИ ПАКЕТАМИ
# ============================================================
[nix]
# Канал Nixpkgs (стабильный выпуск от мая 2024)
channel = "stable-24_05"

# Список системных библиотек, необходимых для графики, шрифтов, GUI
packages = [
    "cairo",            # 2D графика (рендеринг)
    "ffmpeg-full",      # обработка видео/аудио
    "freetype",         # шрифты
    "ghostscript",      # работа с PostScript/PDF
    "glibcLocales",     # локали (для корректной кодировки)
    "gobject-introspection", # динамические привязки для GObject
    "gtk3",             # тулкит GTK3 (графический интерфейс)
    "pkg-config",       # поиск зависимостей при компиляции
    "qhull",            # вычислительная геометрия (многогранники)
    "tcl",              # язык Tcl (нужен некоторым граф. библиотекам)
    "tk"                # тулкит Tk (графическое расширение Tcl)
]

# ============================================================
# РАЗДЕЛ 3: ТЕСТИРОВАНИЕ
# ============================================================
[unitTest]
language = "python3"

# ============================================================
# РАЗДЕЛ 4: РАЗВЁРТЫВАНИЕ (DEPLOYMENT)
# ============================================================
[deployment]
# Команда для запуска на удалённом сервере (совпадает с run)
run = ["python", "manage.py", "runserver", "0.0.0.0:3000"]
# Целевая платформа – Google Compute Engine (GCE)
deploymentTarget = "gce"

# ============================================================
# РАЗДЕЛ 5: ПРОБРОС ПОРТОВ
# ============================================================
# Порт 3000 (основное веб-приложение)
[[ports]]
localPort = 3000    # порт внутри контейнера/ВМ
externalPort = 3000 # порт на внешнем интерфейсе

# Порт 5000 (дополнительный сервис, возможно, API или второй экземпляр)
[[ports]]
localPort = 5000
externalPort = 5000

# ============================================================
# РАЗДЕЛ 6: АГЕНТ (ВНУТРЕННИЕ НАСТРОЙКИ ПЛАТФОРМЫ)
# ============================================================
[agent]
# Режим эксперта – доступ к расширенным возможностям
expertMode = true
# Стратегия выбора стека – "лучшее усилие с откатом"
stack = "BEST_EFFORT_FALLBACK"

# ============================================================
# РАЗДЕЛ 7: WORKFLOWS – ОПРЕДЕЛЕНИЕ ЗАДАЧ ЗАПУСКА
# ============================================================
[workflows]
# Кнопка в интерфейсе, которая запускает этот workflow
runButton = "Project"

# Первый workflow – "Project" (параллельный запуск)
[[workflows.workflow]]
name = "Project"
mode = "parallel"   # задачи внутри выполняются параллельно
author = "agent"    # создано агентом автоматически

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"   # запускает дочерний workflow с именем "Start application"

# Второй workflow – фактический запуск приложения
[[workflows.workflow]]
name = "Start application"
author = "agent"

# Метаданные – тип вывода (webview означает встроенный браузер/вкладка)
[workflows.workflow.metadata]
outputType = "webview"

# Задача: выполнить shell-команду для запуска Django на порту 5000
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python manage.py runserver 0.0.0.0:5000"
waitForPort = 5000   # ждать, пока порт 5000 начнёт слушать